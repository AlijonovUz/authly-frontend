# Backend manzili (oxirida / siz). Bo'sh qolsa — so'rovlar shu domenning /api/... yo'liga ketadi
VITE_API_URL=https://backend-passport.raqamlinazorat.uz

# Faqat lokal ishlash uchun: VITE_API_URL bo'sh bo'lsa, `npm run dev` /api so'rovlarini shu yerga uzatadi
# VITE_API_PROXY=https://backend-passport.raqamlinazorat.uz

# Kod yuboradigan Telegram bot (@ belgisisiz)
VITE_TELEGRAM_BOT=raqamli_passport_bot

# Google OAuth client ID (Google Cloud Console). Redirect URI sifatida frontend'ning bosh sahifasi
# ro'yxatga olinishi kerak: http://localhost:5173/ va https://<frontend domeni>/
VITE_GOOGLE_CLIENT_ID=
